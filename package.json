{
  "name": "@wvp/multitool",
  "version": "0.0.1",
  "description": "Workshop MultiTool - CLI for everything",
  "main": "dist/cli.js",
  "bin": {
    "multitool": "bin/multitool",
    "mt": "bin/multitool"
  },
  "files": [
    "dist",
    "bin",
    "services"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc",
    "depcheck:local": "madge src/cli.ts --circular",
    "lint": "eslint --config .eslintrc.js src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint --config .eslintrc.js src/ --ext .js,.jsx,.ts,.tsx --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build"
  },
  "author": "Jason C",
  "license": "ISC",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "commander": "^10.0.1",
    "gluegun": "^5.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@types/node": "^20.1.4",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "eslint": "^8.40.0",
    "husky": "^8.0.3",
    "madge": "^6.0.0",
    "typescript": "^5.0.4"
  }
}
